# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Dependencies and build output
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
playwright-report/
test-results/

# Runtime data and user content
data/
**/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
uploads/
attachments/

# Local tools and generated artifacts
.agents/
.archify/
.claude/
.cache/
*.png
*.PNG
*.jpg
*.jpeg
*.webp
.DS_Store

# The blanket image ignores above are for screenshots and user content (both
# already excluded via .agents/, data/, uploads/ and attachments/). They must
# NOT swallow the application's own static assets: the app icons were silently
# untracked by *.png, so fresh clones served a page whose icon requests 404'd —
# which is how the GitHub CI e2e run first exposed the static-server crash.
!frontend/icons/**
