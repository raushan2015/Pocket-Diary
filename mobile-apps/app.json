{
  "expo": {
    "name": "Pocket Diary",
    "slug": "pocket-diary",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "pocketdiary",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pocketdiary.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pocket Diary attaches images from your photo library to your notes.",
        "NSCameraUsageDescription": "Pocket Diary can photograph attachments for your notes."
      }
    },
    "android": {
      "package": "app.pocketdiary.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png"
      },
      "edgeToEdgeEnabled": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E1B4B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Pocket Diary to use Face ID to protect your session."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
