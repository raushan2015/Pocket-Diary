{
  "name": "pocket-diary-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first Expo/React Native client for self-hosted Pocket Diary servers.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm run typecheck && npm run lint && npm run test",
    "assets": "node scripts/gen-assets.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~53.0.0",
    "expo-constants": "~17.1.0",
    "expo-crypto": "~14.1.0",
    "expo-file-system": "~18.1.0",
    "expo-image-picker": "~16.1.0",
    "expo-linking": "~7.1.0",
    "expo-localization": "~16.1.0",
    "expo-notifications": "~0.31.0",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.0",
    "expo-sharing": "~13.1.0",
    "expo-sqlite": "~15.2.0",
    "expo-status-bar": "~2.2.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "~19.0.10",
    "better-sqlite3": "^11.10.0",
    "eslint": "^9.20.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
