# Pocket Diary Mobile — build-time environment
#
# Only EXPO_PUBLIC_* variables are safe here: they are embedded in the app
# bundle at build time and must NEVER contain secrets. The app connects to a
# user-configured server at runtime (first-launch setup screen) — no server
# URL, credential or token belongs in this file.

# Optional: prefill the server-setup screen's URL field in local development
# builds (never shipped to stores). Leave empty for the public app.
# EXPO_PUBLIC_DEV_SERVER_URL=http://localhost:8080
