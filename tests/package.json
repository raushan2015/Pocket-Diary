{
  "name": "pocket-diary-qa-tests",
  "version": "1.0.0",
  "description": "End-to-End QA Verification and System Certification Test Suites for Pocket Diary (split into e2e/*.test.js journey files)",
  "type": "module",
  "scripts": {
    "test": "node --test --test-timeout=180000 --test-concurrency=4 e2e/*.test.js",
    "test:e2e": "node --test --test-timeout=180000 --test-concurrency=4 e2e/*.test.js",
    "test:unit": "node --test md-import.test.js markdown-xss.test.js i18n.test.js",
    "test:i18n": "node --test i18n.test.js",
    "verify:i18n": "node i18n-verify.mjs",
    "a11y": "BASE_URL=http://localhost:8080 node a11y-audit.js"
  },
  "author": "TECHSHAN AI Office - QA Agent",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.0"
  }
}