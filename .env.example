# Host port published by Docker Compose
PORT=8080

# Generate with: openssl rand -hex 32
# Keep this value private and never commit your real .env file.
COOKIE_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# ---------------------------------------------------------------------------
# Reminders (optional)
# ---------------------------------------------------------------------------
# How often the backend scans for due reminders and creates notifications
# (default 30000 ms; minimum 10000 ms).
#REMINDER_SCAN_INTERVAL_MS=30000

# How long after becoming due a reminder is still delivered (default 2 hours).
# Reminders older than this window are skipped on restart (anti-spam) and a
# warning is logged with the count. Raise this if your server is often offline
# for longer stretches.
#REMINDER_FRESH_WINDOW_MS=7200000

# Per-workspace storage quota in GB (default 10). Counts real bytes: note text
# (UTF-8) plus attachment file sizes.
#STORAGE_QUOTA_GB=10

# Public base URL used inside reminder emails, invitation and password-reset links.
# REQUIRED in production — the backend refuses to start without it (audit C-3:
# links must never be derived from request headers, which an attacker can forge
# to poison a victim's password-reset email).
# Set this to the URL users type in the browser, e.g. https://notes.example.com
APP_URL=http://localhost:8080

# Optional SMTP transport for reminder emails and workspace invitations.
# Without SMTP_HOST, email delivery is disabled; in-app notifications still work
# and invitations show a copyable invite link instead.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=Notes <no-reply@notes.local>

# Optional Web Push (VAPID) credentials so reminders reach the browser even
# when the app is closed. Generate once with:
#   cd backend && node -e "console.log(require('web-push').generateVAPIDKeys())"
# Without these keys, push delivery is disabled; in-app notifications still work.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Backups (optional)
# ---------------------------------------------------------------------------
# Local snapshot cadence and retention (snapshots live next to the database).
#BACKUP_INTERVAL_HOURS=24
#BACKUP_RETENTION=7

# Off-host replication: every new snapshot is ALSO copied to this directory.
# Point it at a location OUTSIDE the Docker data volume (NFS mount, host bind
# mount) so notes survive volume or host loss.
#BACKUP_REPLICATION_DIR=/mnt/backup/notes-replica
#BACKUP_REPLICATION_RETENTION=7

# ---------------------------------------------------------------------------
# Reverse proxy (optional)
# ---------------------------------------------------------------------------
# Whose X-Forwarded-For header may rewrite the client IP used by rate limiting
# (audit H-1). The default trusts only the loopback proxy this app ships with.
# Set to the proxy's address or subnet when running behind another proxy, or
# 'false' when the backend is exposed directly.
#TRUST_PROXY=127.0.0.1

# ---------------------------------------------------------------------------
# Rate limiting (optional)
# ---------------------------------------------------------------------------
# Global request budget per minute (default 300). Raise for heavy automated use.
#RATE_LIMIT_MAX=300

# Per-minute budget for the login and register endpoints (default 15). Raise
# only for CI or ephemeral instances where all traffic shares one client IP;
# per-account lockout still applies regardless.
#AUTH_RATE_LIMIT_MAX=15

# Serve the generated OpenAPI/Swagger API reference at /docs (default: on).
# The spec contains only route shapes and descriptions — never secrets.
# Set to false to hide the docs on instances that must not expose them.
#DOCS_ENABLED=true
